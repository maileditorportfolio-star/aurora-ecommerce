# Root environment for `docker compose` (copy to .env and edit).
# Values shown here are the defaults used when .env is absent.

# Database
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=aurora_commerce
MYSQL_PORT=3306

# Ports
API_PORT=4000
STOREFRONT_PORT=3000

# API
# These mirror server/.env.example so a root .env is self-contained for
# `npm run dev` / `npm start`. Docker Compose only reads the MYSQL_* and
# *_PORT values from this file.
NODE_ENV=development
PORT=4000
DATABASE_URL="mysql://root:root@localhost:3306/aurora_commerce"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
AUTH_RATE_LIMIT=20
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=info

# Storefront pricing (read by the API)
SHIPPING_FLAT_RATE=60
SHIPPING_FREE_THRESHOLD=5000
TAX_RATE=0

# Storefront (inlined at build time)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Error tracking (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
