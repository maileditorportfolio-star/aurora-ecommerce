{
  "name": "aurora-ecommerce",
  "version": "0.1.0",
  "private": true,
  "description": "Aurora Commerce — Next.js 14 + Express + Prisma + MySQL e-commerce platform for Aurora Cyber",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace server && npm run build --workspace client",
    "build:server": "npm run build --workspace server",
    "build:client": "npm run build --workspace client",
    "start": "concurrently -n server,client -c magenta,cyan \"npm:start:server\" \"npm:start:client\"",
    "start:server": "npm run start --workspace server",
    "start:client": "npm run start --workspace client",
    "lint": "npm run lint:server && npm run lint:client",
    "lint:server": "npm run lint --workspace server",
    "lint:client": "npm run lint --workspace client",
    "lint:fix": "npm run lint:fix --workspace server && npm run lint:fix --workspace client",
    "typecheck": "npm run typecheck --workspace client",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css}\"",
    "prisma:generate": "npm run prisma:generate --workspace server",
    "prisma:migrate": "npm run prisma:migrate --workspace server",
    "prisma:push": "npm run prisma:push --workspace server",
    "prisma:studio": "npm run prisma:studio --workspace server",
    "seed": "npm run seed --workspace server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "eslint-config-prettier": "^9.1.2",
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
