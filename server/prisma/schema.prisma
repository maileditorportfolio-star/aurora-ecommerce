// Aurora Commerce — Prisma schema (MySQL)
// Run: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum MessageSender {
  USER
  ADMIN
  SYSTEM
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         Role     @default(CUSTOMER)
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders   Order[]
  messages Message[]

  @@index([role])
  @@map("users")
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@map("categories")
}

model Product {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  description    String   @db.Text
  price          Float
  compareAtPrice Float?
  imageUrl       String?
  gallery        Json?
  sku            String?  @unique
  stock          Int      @default(0)
  categoryId     String?
  rating         Float    @default(0)
  reviewCount    Int      @default(0)
  featured       Boolean  @default(false)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category   Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orderItems OrderItem[]

  @@index([categoryId])
  @@index([featured])
  @@index([active])
  @@map("products")
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  userId          String
  status          OrderStatus @default(PENDING)
  subtotal        Float
  shipping        Float       @default(0)
  tax             Float       @default(0)
  total           Float
  paymentMethod   String      @default("cod")
  paymentStatus   String      @default("UNPAID")
  shippingName    String
  shippingPhone   String
  shippingAddress String      @db.Text
  shippingCity    String?
  shippingZip     String?
  shippingCountry String      @default("Bangladesh")
  note            String?     @db.Text
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items OrderItem[]

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  name      String
  imageUrl  String?
  unitPrice Float
  quantity  Int     @default(1)
  subtotal  Float

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Message {
  id             String        @id @default(cuid())
  conversationId String        @default("support")
  userId         String?
  sender         MessageSender @default(USER)
  content        String        @db.Text
  readAt         DateTime?
  createdAt      DateTime      @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([userId])
  @@map("messages")
}
